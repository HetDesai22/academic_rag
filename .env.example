# Copy to .env and fill in what you use. .env is loaded automatically; never commit real keys.

# Claude (default generator + automatic evaluator + topic-label check)
ANTHROPIC_API_KEY=

# Any OpenAI-compatible endpoint (set llm.provider: openai_compatible in config.yaml)
# OpenAI:     OPENAI_API_KEY=sk-...  OPENAI_MODEL=<model name>
# Ollama:     OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_MODEL=llama3.1:8b
# LM Studio:  OPENAI_BASE_URL=http://localhost:1234/v1   OPENAI_MODEL=<loaded model>
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Optional: faster Hugging Face model downloads
HF_TOKEN=

# Optional: alternative config file (used by the incremental-update sandbox)
# AQI_CONFIG=path/to/config.yaml
